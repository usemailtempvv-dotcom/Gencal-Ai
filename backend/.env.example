# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Twilio Configuration
# Get these from your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWIML_APP_SID=your_twiml_app_sid

# OpenAI Configuration (for speech-to-text)
OPENAI_API_KEY=your_openai_api_key
OPENAI_STT_MODEL=whisper-1

# Speech-to-Text Provider
# Options: groq or openai
STT_PROVIDER=groq

# Groq Configuration (for speech-to-text)
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TRANSCRIPT_MODEL=gemini-1.5-flash

# Botpress Chat API Configuration
# Get these from your Botpress Cloud Dashboard
BOTPRESS_BOT_ID=your_bot_id
BOTPRESS_CLIENT_ID=your_client_id
# API token (PAT) with chat runtime scope
BOTPRESS_API_TOKEN=your_api_token
BOTPRESS_INTEGRATION_ALIAS=your_integration_alias

# Local admin login credentials (optional)
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=your_admin_password

# Database (SQLite by default, change if needed)
# DATABASE_URL=sqlite:///db.sqlite3
